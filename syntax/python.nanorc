## Syntax highlighting for Python.

syntax python "\.py$"
header "^#!.*python"
magic "Python script"
comment "#"

# Alternative linter: pylint --exit-zero
linter pyflakes

# Function definitions.
color nblaccent "(def|class)[[:blank:]]+[[:alnum:]_]+"
# Keywords.
color nblkeyword "\<(and|as|assert|async|await|break|case|class|continue|def|del)\>"
color nblkeyword "\<(elif|else|except|finally|for|from|global|if|import|in|is)\>"
color nblkeyword "\<(lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield)\>"
# In Python 2 `print` and `exec` are keywords, but they are functions in Python 3,
# so only color these words when they are followed by whitespace, assuming that
# `print (x)` is a statement and `print(x)` a function call.
color nblkeyword "\<(exec|print)([[:blank:]]|$)"
# Avoid coloring "match" in a call of re.match().
color nblkeyword "\<match[[:blank:]]"

# Special values.
color nblnumber "\<(False|None|True)\>"

color nblnumber "\<(0[xX][[:xdigit:]_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(\.[0-9_]*)?([eE][+-]?[0-9_]+)?[jJ]?)\>"

# Decorators.
color nblaccent "@[[:alpha:]_][[:alnum:]_.]*"

# Mono-quoted strings.
color nblstring "'([^'\]|\\.)*'|"([^"\]|\\.)*"|'''|""""
color normal "'''|""""
# Comments.
color nblcomment "(^|[[:blank:]])#.*"
# Triple-quoted strings.
color nblstring start="'''([^'),]|$)" end="(^|[^(\])'''"
color nblstring start=""""([^"),]|$)" end="(^|[^(\])""""

# Backslash escapes.
color nblsoft "\\($|[\'"abfnrtv]|[0-3]?[0-7]?[0-7]|x[[:xdigit:]]{2})"
color nblsoft "\\(N\{[[:alpha:]]+\}|u[[:xdigit:]]{4}|U[[:xdigit:]]{8})"

# Reminders.
color brightwhite,yellow "\<(FIXME|TODO|XXX)\>"

# Trailing whitespace.
color ,green "[[:space:]]+$"
