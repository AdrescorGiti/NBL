## Syntax highlighting for C and C++ files.

syntax c "\.([ch](pp|xx)?|C|cc|c\+\+|cu|H|hh|ii?)$"
header "-\*-.*\<C(\+\+)?((;|[[:blank:]]).*)?-\*-"
magic "^(C|C\+\+) (source|program)"
comment "//"

# Constants.
color brightred "\<[[:upper:]_][[:upper:][:digit:]_]*\>"
# Labels.
color brightmagenta "^[[:blank:]]*[[:alpha:]_][[:alnum:]_]*:[[:blank:]]*$"
color normal ":[[:blank:]]*$"

# Types and related keywords.
color nblkeyword "\<(bool|char|double|enum|float|int|long|short|(un)?signed|struct|union|void|((u_?)?int(_fast|_least)?(8|16|32|64)|[[:lower:]][[:lower:]_]*)_t)\>"
color nblkeyword "\<(align(as|of)|auto|const(eval|expr|init)?|extern|inline|register|restrict|sizeof|static(_assert)?|thread_local|typedef|typeof(_unqual)?|volatile)\>"
color nblkeyword "\<(_(Align(as|of)|Atomic|BitInt|Bool|Complex|Decimal(32|64|128)|Generic|Imaginary|Noreturn|Static_assert|Thread_local))\>"
color nblkeyword "\<(class|explicit|final|friend|mutable|namespace|override|private|protected|public|template|this|typename|using|virtual)\>"
color nblkeyword "\<(char(8|16|32)_t|wchar_t|(const|dynamic|reinterpret|static)_cast|decltype|export|import|module|noexcept|requires|typeid)\>"

# Function names, qualified names, and numeric constants.
color nblaccent "\<[[:alpha:]_][[:alnum:]_]*[[:blank:]]*\(" "\<[[:alpha:]_][[:alnum:]_]*::"
color nblnumber "\<[0-9][0-9']*(\.[0-9']*)?([eE][+-]?[0-9']+)?[uUlLfF]*\>"

# Flow control.
color nblkeyword "\<(if|else|for|while|do|switch|case|default)\>"
color nblkeyword "\<(try|throw|catch|operator|new|delete)\>"
color nblkeyword "\<(break|continue|goto|(co_)?return)\>"

# Single-quoted stuff (characters, backslash escapes, hex and octal byte codes).
color nblstring "'([^'\]|\\(["'\abfnrtv]|x[[:xdigit:]]{1,2}|[0-3]?[0-7]{1,2}))'"

# Hexadecimal, binary, and boolean values.
color nblnumber "\<(0[Xx][[:xdigit:]]['[:xdigit:]]*|0[Bb][01]['01]*|true|false|nullptr)\>"

# GCC builtins.
color cyan "__attribute__[[:blank:]]*\(\([^)]*\)\)|__(aligned|asm|builtin|hidden|inline|packed|restrict|section|typeof|weak)__"

# Strings and names of included files.
color nblstring ""([^"]|\\")*"|#[[:blank:]]*include[[:blank:]]*<[^>]+>"

# Preprocessor directives.
color nblaccent start="^[[:blank:]]*#[[:blank:]]*((el)?if(n?def)?|error|pragma|warning)\>" end="(\`|[^\])$"
color nblaccent "^[[:blank:]]*#[[:blank:]]*((define|else|embed|endif|include(_next)?|line|undef)\>|$)"

# Comments.
color nblcomment "//[^"]*$|(^|[[:blank:]])//.*"
color nblcomment start="/\*" end="\*/"

# Reminders.
color brightwhite,yellow "\<(FIXME|TODO|XXX)\>"

# Trailing whitespace.
color ,green "[[:space:]]+$"
