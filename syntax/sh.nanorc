## POSIX shell highlighting for NBL.
## Based on GNU nano's shell syntax by Mike Frysinger (GPL version 3 or later).

syntax sh "(\.sh|\.bash|(^|/|\.)(a|ba|da|k|mk|pdk|z)sh(rc|_profile)?|(/etc/|(^|/)\.)profile)$"
header "^#!.*/(((env|busybox)[[:blank:]]+)?(a|ba|da|k|mk|pdk|z)?sh)\>"
header "-\*-.*shell-script.*-\*-"
magic "(POSIX|Bourne-Again) shell script.*text"
comment "#"

# Operators, redirection, builtins, control words and declarations.
color nblsoft "[][{}();|<>&!]" "[-](eq|ne|gt|lt|ge|le|ef|ot|nt)\>"
color nblkeyword "\<(break|case|continue|do|done|elif|else|esac|exit|fi|for|if|in|return|then|until|while)\>"
color nblsoft "\<(alias|cd|command|eval|exec|export|getopts|read|readonly|set|shift|test|trap|type|umask|unalias|unset|wait)\>"
color nblsuccess "^[[:blank:]]*[[:alpha:]_][[:alnum:]_]*[[:blank:]]*\([[:blank:]]*\)"
color nbllight "\<[[:alpha:]_][[:alnum:]_]*="
color nblstring ""([^"\]|\\.)*"|'[^']*'"
color nbllight "\$([-@*#?$![:digit:]]|[[:alpha:]_][[:alnum:]_]*)"
color nbllight "\$\{[^}]*\}" "\$\(\(" "\$\(" "`[^`]*`"
# A hash starts a comment when it is an unquoted word boundary. This
# expression skips the common quoted and escaped forms preceding it.
color nblcomment "^([^#'"\\]|\\.|'[^']*'|"([^"\\]|\\.)*")*[[:blank:];|&]#.*" "^#.*"
